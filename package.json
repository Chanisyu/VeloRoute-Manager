{
  "name": "veloroute-manager",
  "version": "1.0.0",
  "description": "Cycling route manager",
  "main": "main.js",
  "author": "VeloRoute Team",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development --base-href ./",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dev": "concurrently --kill-others --success first -n angular,electron \"npm:start\" \"npm:electron:watch\"",
    "electron:dev": "npm run dev",
    "electron:watch": "wait-on --timeout 120000 http-get://127.0.0.1:4200 && cross-env VELOROUTE_DEV_SERVER=1 nodemon --watch main.js --watch preload.js --watch desktop --watch storage --watch shared --ext js,mjs,cjs --exec \"electron .\"",
    "test": "npm run test:storage && npm run build && playwright test",
    "check": "node --check main.js && node --check preload.js && node --check desktop/gpx-studio.cjs && node --check storage/store.mjs && npm test",
    "prestart": "node scripts/check-runtime.cjs",
    "prebuild": "node scripts/check-runtime.cjs",
    "predev": "node scripts/check-runtime.cjs",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:statistics": "node --test tests/statistics.test.mjs tests/route-profile.test.mjs",
    "test:fit": "node --test tests/fit-route.test.mjs",
    "pretest": "npm run test:statistics && npm run test:fit"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "18.2.14",
    "@angular/compiler": "18.2.14",
    "@angular/core": "18.2.14",
    "@angular/forms": "18.2.14",
    "@angular/platform-browser": "18.2.14",
    "coordtransform": "2.1.2",
    "fit-file-parser": "6.2.10",
    "mapbox-gl": "3.9.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.21",
    "@angular/cli": "18.2.21",
    "@angular/compiler-cli": "18.2.14",
    "@types/node": "22.19.1",
    "electron": "30.5.1",
    "electron-builder": "24.13.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.4.5",
    "@playwright/test": "1.56.1",
    "concurrently": "9.2.5",
    "cross-env": "7.0.3",
    "nodemon": "3.1.11",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.veloroute.manager",
    "productName": "VeloRoute Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "desktop/gpx-studio.cjs",
      "package.json",
      "storage/**/*.mjs",
      "shared/**/*.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8"
}
